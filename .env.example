# .env.example — SEULES variables à renseigner par le propriétaire (copier en .env.local)
# URL publique de l'app, sert à vérifier l'en-tête Origin (ex: https://motionia.app, en local http://localhost:3000)
APP_ORIGIN=http://localhost:3000
# Chaîne de connexion MongoDB Atlas
MONGODB_URI=
# Secret de signature des sessions (openssl rand -base64 32). ROTATION : changer la valeur déconnecte tout le monde.
AUTH_SECRET=
# OAuth Google (console.cloud.google.com > Identifiants). URI de redirection : {APP_ORIGIN}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Clé de l'API Gemini (aistudio.google.com)
GEMINI_API_KEY=
# Cloudflare R2 (bucket PRIVÉ ; CORS : autoriser PUT/GET depuis APP_ORIGIN et exposer l'en-tête ETag)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Emails admin séparés par des virgules (rôle posé à l'inscription)
ADMIN_EMAILS=
# Secret du cron de purge (appel : POST /api/cron/cleanup avec Authorization: Bearer <secret>)
CRON_SECRET=
# Paiement : Polar (revendeur officiel / Merchant of Record). Laisser vide = pas de paiement en ligne (crédits accordés à la main dans l'admin).
# Jeton d'accès : Polar › Settings › Developers › Access Tokens (droits : checkouts, customer_sessions, subscriptions, products en lecture)
POLAR_ACCESS_TOKEN=
# Secret du webhook : Polar › Settings › Webhooks (URL : {APP_ORIGIN}/api/billing/webhook)
POLAR_WEBHOOK_SECRET=
# "sandbox" (TEST, par défaut) ou "production". Les ID produit du bac à sable ne sont PAS ceux de la production.
POLAR_SERVER=sandbox
